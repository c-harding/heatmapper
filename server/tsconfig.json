{
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["node"],
    "target": "es2020",
    "module": "NodeNext",
    "allowJs": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "outDir": "../dist/server",
    "strict": false,
    "strictNullChecks": true
  },
  "ts-node": {
    // ts-node also compiles the shared package, which is outside this directory
    "compilerOptions": { "rootDir": ".." }
  },
  "exclude": ["*.config.mjs"]
}
