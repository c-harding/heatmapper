{
  "url": "https://www.strava.com/tiles/pois/default-poi-style.json?style=standard",
  "glyphs": "mapbox://fonts/charding/{fontstack}/{range}.pbf",
  "fonts": {
    "Boathouse Regular": [
      "DIN Pro Regular",
      "Noto Sans Regular",
      "Noto Sans Armenian Regular"
    ],
    "Boathouse Medium": [
      "DIN Pro Medium",
      "Noto Sans Medium",
      "Noto Sans Armenian Medium"
    ],
    "Boathouse Medium Oblique": "DIN Pro Medium Italic",
    "Boathouse Bold": [
      "DIN Pro Bold",
      "Noto Sans Bold",
      "Noto Sans Armenian Bold"
    ],
    "Maison Neue APP Bold": [
      "DIN Pro Bold",
      "Noto Sans Bold",
      "Noto Sans Armenian Bold"
    ]
  },
  "sources": {
    "pois": null,
    "networks": null,
    "mapterhorn": {
      "type": "raster-dem",
      "tiles": ["https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"],
      "tileSize": 512,
      "encoding": "terrarium",
      "attribution": "<a href=\"https://mapterhorn.com/attribution\">© Mapterhorn</a>"
    }
  },
  "layers": {
    "national-park-label": {
      "paint": {
        "text-opacity": 1,
        "icon-opacity": 1
      }
    },
    "hillshade": {
      "type": "hillshade",
      "source": "mapterhorn",
      "source-layer": null,
      "paint": {
        "fill-color": null,
        "fill-opacity": null,
        "fill-antialias": null,
        "hillshade-exaggeration": 0.175
      }
    }
  }
}
