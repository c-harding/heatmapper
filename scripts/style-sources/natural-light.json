{
  "url": "https://www.strava.com/tiles/pois/default-poi-style.json?style=standard",
  "glyphs": "mapbox://fonts/charding/{fontstack}/{range}.pbf",
  "fonts": {
    "Boathouse Regular": "DIN Pro Regular",
    "Boathouse Medium": "DIN Pro Medium",
    "Boathouse Medium Oblique": "DIN Pro Medium Italic",
    "Boathouse Bold": "DIN Pro Bold",
    "Maison Neue APP Bold": "DIN Pro Bold"
  },
  "sources": {
    "pois": null,
    "networks": null,
    "mapbox-dem": {
      "url": "mapbox://mapbox.mapbox-terrain-dem-v1",
      "type": "raster-dem",
      "tileSize": 256,
      "maxzoom": 14
    }
  },
  "layers": {
    "national-park-label": {
      "paint": {
        "text-opacity": 1,
        "icon-opacity": 1
      }
    },
    "hillshade": {
      "type": "hillshade",
      "source": "mapbox-dem",
      "source-layer": null,
      "paint": {
        "fill-color": null,
        "fill-opacity": null,
        "fill-antialias": null,
        "hillshade-exaggeration": 0.175
      }
    }
  }
}
