#!/usr/bin/env bash

set -e

# Where the user actually was, captured before the cd below moves us to the checkout root: yarn
# leaves it in INIT_CWD, and without yarn $PWD is still the caller's until that cd runs. Relative
# paths on the command line are resolved against this.
CALLER_DIR="${INIT_CWD:-$PWD}"

cd "$(dirname "$0")/.."

. scripts/lib

COMMAND=''
PORT=''
INSTALL=1
SERVE=0
ATTACH=''
DETACH=0
FORCE=0
UTC=0
DELETE=0
DELETE_BACKUPS=0
NEW_BRANCH=''
RESET_BRANCH=0
ARGS=()

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

usage() {
    case ${1:-} in
        add)
            cat <<'EOF'
Usage: yarn worktree add <commit-ish> [dir] [options]

Create a worktree, give it its own dev-server ports and install its dependencies. Without [dir]
it goes under .worktrees/, named after the branch or commit. A bare [dir] is a name under
.worktrees/ too; use a path with a slash or a leading dot to put it somewhere else.

<commit-ish> follows "git worktree add": a branch is checked out, a tag or commit is checked out
detached, and a name that does not exist yet becomes a new branch off HEAD.

Options:
  -b, --new-branch <name>    create <name> starting at <commit-ish>, and check that out instead
  -B, --reset-branch <name>  the same, but reset <name> if it already exists
  -d, --detach               check out <commit-ish> detached, even if it is a branch
  -p, --port <n>             use <n> for the backend and <n>+1 for the frontend, instead of
                             the first free pair
  -n, --no-install           skip the "yarn" that installs dependencies
  -s, --serve                start the dev servers once it is set up
  -a, --attach               with --serve, attach to them rather than leaving them running
                             in the background
  -A, --no-attach            with --serve, leave them in the background, which is the default
EOF
            ;;
        bootstrap)
            cat <<'EOF'
Usage: yarn worktree bootstrap [dir] [options]

Set up a worktree that already exists, for instance one made with plain "git worktree add":
write its .env and install its dependencies. Defaults to the current worktree, and does nothing
if it is already set up.

Options:
  -p, --port <n>    use <n> for the backend and <n>+1 for the frontend,
                    instead of the first free pair
  -n, --no-install  skip the "yarn" that installs dependencies
  -f, --force       rewrite an existing .env, reallocating the ports
EOF
            ;;
        serve)
            cat <<'EOF'
Usage: yarn worktree serve [dir] [options]

Start the dev servers for a worktree, in the background by default. Defaults to the current one.

Options:
  -a, --attach      attach to the servers; if they are already running, attach without restarting
  -A, --no-attach   stay in the background, cancelling an earlier --attach
EOF
            ;;
        list)
            cat <<'EOF'
Usage: yarn worktree list

Show every worktree with its branch, its dev-server ports and whether those servers are running.
EOF
            ;;
        remove)
            cat <<'EOF'
Usage: yarn worktree remove [dir] [options]

Stop a worktree's dev servers and delete it. Defaults to the current worktree. The branch itself
is left alone. Refuses to run if anything would be lost: uncommitted changes, or untracked
files that are not ignored. Lists any backups the worktree made, unless told to delete them, and
leaves them alone if another worktree's backups are filed under the same name.

Options:
  -f, --force       delete anyway; pass twice to unlock a locked worktree
      --delete-backups
                    delete the worktree's backups too
      --utc         show the times of any backups it leaves in UTC
EOF
            ;;
        backup)
            cat <<'EOF'
Usage: yarn worktree backup <label> [commit-ish] [options]

Keep a ref to a commit, by default the current worktree's HEAD, such as before rewriting history.
It is named after the worktree and the time in UTC, as
refs/backup/<worktree>/<YYYY-MM-DD>T<HHMM>Z-<label>, so a label can be used again: each use makes
a new backup. List and delete them with "yarn worktree backups".

A label is a short name such as pre-rebase. It can be anything git allows in a ref name, except
that it cannot contain a slash or an @, or start with a -.

Options:
  -f, --force       replace a backup with the same label made in the same minute
EOF
            ;;
        backups)
            cat <<'EOF'
Usage: yarn worktree backups [worktree] [options]
       yarn worktree backups --delete <worktree> [<label>[@<time>]...]

List the backups made with "yarn worktree backup", newest first: those of one worktree, or of
all of them. A worktree is named by its directory under .worktrees/, as the listing shows it, or
"_main" for the main checkout, and need not still exist.

With --delete, delete a worktree's backups: those with each label given, or all of them if none
is. A label followed by @<time> picks the one listed at that time, given in full
(2026-10-24T23:02), as a time of day (23:02) or as a date (2026-10-24), as long as only one
backup with that label matches. A time ending in Z is in UTC, and one ending in an offset such
as +01:00 is in that offset, which tells apart the two backups listed at the same time when the
clocks go back.

Options:
      --delete      delete backups rather than listing them
      --utc         show times in UTC, and take times given without a zone as UTC
EOF
            ;;
        *)
            cat <<'EOF'
Manage git worktrees of this project, each running its dev servers on its own ports and sharing
one copy of the credentials in the main checkout's .env.

Usage: yarn worktree <command> [options]

Commands:
  add, a        <commit-ish> [dir] create a worktree, set it up, optionally start it
  bootstrap, b  [dir]              set up a worktree that already exists
  serve, s      [dir]              start, or attach to, a worktree's dev servers
  list, l, ls                      show every worktree, its ports and whether it is running
  remove, r, rm [dir]              stop the dev servers and delete a worktree
  backup        <label> [commit]   keep a ref to a commit, such as before a rebase
  backups       [worktree]         list backups, or delete them with --delete
  help, h       [command]          show this, or the options of one command
EOF
            ;;
    esac
}

# Fail unless the current command takes this option, rather than quietly ignoring it. $1 names
# the option in the command's list above, $2 is how the user spelled it.
require_option() {
    case " $ALLOWED " in
        *" $1 "*) return 0 ;;
    esac
    die "\"$COMMAND\" does not take $2. Try \"yarn worktree help $COMMAND\"."
}

# Take a port only if it really is one, so that --port= or --port=abc fails loudly instead of
# quietly falling back to automatic allocation. $2 is how the user spelled the option.
set_port() {
    case $1 in
        '') die "$2 needs a port number. Try \"yarn worktree help $COMMAND\"." ;;
        *[!0-9]*) die "Not a port number: \"$1\"" ;;
    esac
    PORT="$1"
}

# Take a branch name only if there is one, and record which of git's flags to use. "git worktree
# add" spells these -b and -B; the long forms are ours, for consistency with the other options.
set_branch() {
    case $1 in
        '') die "$2 needs a branch name. Try \"yarn worktree help $COMMAND\"." ;;
    esac
    NEW_BRANCH="$1"
    # Cleared as well as set, so that the last of -b and -B wins, as a repeat of either does.
    case $2 in
        -B | --reset-branch) RESET_BRANCH=1 ;;
        *) RESET_BRANCH=0 ;;
    esac
}

parse_args() {
    ALLOWED="$1"
    shift
    while (($#)); do
        case $1 in
            -h | --help)
                usage "$COMMAND"
                exit 0
                ;;
            -p | --port)
                require_option port "$1"
                set_port "$2" "$1"
                shift 2
                ;;
            -p?*)
                require_option port "--port"
                set_port "${1:2}" "-p"
                shift
                ;;
            --port=*)
                require_option port "--port"
                set_port "${1#*=}" "--port"
                shift
                ;;
            -b | --new-branch | -B | --reset-branch)
                require_option branch "$1"
                set_branch "${2:-}" "$1"
                shift 2
                ;;
            -b?* | -B?*)
                require_option branch "${1:0:2}"
                set_branch "${1:2}" "${1:0:2}"
                shift
                ;;
            --new-branch=* | --reset-branch=*)
                require_option branch "${1%%=*}"
                set_branch "${1#*=}" "${1%%=*}"
                shift
                ;;
            -[!-]?*)
                # Whatever is still bundled here takes no value, since the arms above have
                # already claimed anything that would have swallowed the rest as one. Peel the
                # first option off and push the remainder back for the next pass: -snp8082
                # becomes -s, then -n, then -p8082.
                set -- "${1:0:2}" "-${1:2}" "${@:2}"
                continue
                ;;
            -n | --no-install)
                require_option install "$1"
                INSTALL=0
                shift
                ;;
            -s | --serve)
                require_option serve "$1"
                SERVE=1
                shift
                ;;
            -a | --attach)
                require_option attach "$1"
                ATTACH=1
                shift
                ;;
            -d | --detach)
                require_option detach "$1"
                DETACH=1
                shift
                ;;
            -A | --no-attach)
                require_option attach "$1"
                ATTACH=0
                shift
                ;;
            -f | --force)
                require_option force "$1"
                FORCE=$((FORCE + 1))
                shift
                ;;
            --utc)
                require_option utc "$1"
                UTC=1
                shift
                ;;
            --delete)
                require_option delete "$1"
                DELETE=1
                shift
                ;;
            --delete-backups)
                require_option delete-backups "$1"
                DELETE_BACKUPS=1
                shift
                ;;
            --)
                shift
                ARGS=("${ARGS[@]}" "$@")
                break
                ;;
            -*)
                die "Unknown option $1. Try \"yarn worktree help $COMMAND\"."
                ;;
            *)
                ARGS=("${ARGS[@]}" "$1")
                shift
                ;;
        esac
    done
}

# A directory as the user meant it: a bare name is a worktree under .worktrees/, anything with a
# slash or a leading dot is a path relative to where the command was run, and absolute stays put.
resolve_dir() {
    case $1 in
        /*) printf '%s\n' "$1" ;;
        .* | */*) printf '%s\n' "${CALLER_DIR%/}/$1" ;;
        *) printf '%s\n' "$(primary_root)/.worktrees/$1" ;;
    esac
}

# The root of the worktree containing a directory.
worktree_root() {
    git -C "$1" rev-parse --show-toplevel 2>/dev/null \
        || die "$1 is not inside a git worktree."
}

target_root() {
    local dir
    dir="$(resolve_dir "${1:-.}")"
    [ -d "$dir" ] || die "No such directory: $dir"
    worktree_root "$dir"
}

require_free_ports() {
    local base="$1" skip="${2:-}" claimed port
    claimed="$(claimed_ports "$skip")"
    for port in "$base" "$((base + 1))"; do
        if printf '%s\n' "$claimed" | grep -qx "$port"; then
            die "Port $port is already assigned to another worktree."
        fi
        if port_listening "$port"; then
            die "Port $port is already in use."
        fi
    done
}

write_worktree_env() {
    local root="$1" primary="$2" base="$3"
    cat > "$root/.env" <<EOF
# Written by scripts/worktree
EXTENDS=$(relpath "$root" "$primary/.env")
SERVER_PORT=$base
VITE_DEV_PORT=$((base + 1))
SERVER_DOMAIN=http://localhost:$((base + 1))
SESSIONS_DIR=$(relpath "$root" "$primary/server/sessions")
EOF
}

do_bootstrap() {
    local root primary base
    root="$(target_root "$1")"
    primary="$(primary_root)"

    if [ "$root" = "$primary" ]; then
        # The main checkout holds the credentials, so it has nothing to extend.
        if [ -e "$root/.env" ]; then
            echo "This is the main checkout and it already has a .env; nothing to do."
        else
            cp "$root/sample.env" "$root/.env"
            echo "Created .env from sample.env."
            echo "Fill in STRAVA_CLIENT_ID, STRAVA_CLIENT_SECRET and MAPBOX_TOKEN before serving."
        fi
        return
    fi

    if [ -e "$root/.env" ] && [ "$FORCE" -eq 0 ]; then
        echo "$(relpath "$primary" "$root")/.env already exists; pass --force to rewrite it."
    else
        [ -f "$primary/.env" ] \
            || die "$primary/.env does not exist; set up the main checkout first."
        if [ -n "$PORT" ]; then
            require_free_ports "$PORT" "$root"
            base="$PORT"
        else
            base="$(alloc_ports '' "$root")"
        fi
        write_worktree_env "$root" "$primary" "$base"
        echo "Wrote $(relpath "$primary" "$root")/.env: backend $base, frontend $((base + 1))."
    fi

    if [ "$INSTALL" -eq 1 ]; then
        (cd "$root" && yarn)
    else
        echo "Skipped the install; run \"yarn\" there before serving."
    fi
}

do_serve() {
    local root session
    root="$(target_root "$1")"
    session="$(session_target "$root")"

    if [ "$ATTACH" = 1 ]; then
        if tmux has-session -t "$session" 2> /dev/null; then
            # Already running: join it rather than letting scripts/serve restart it.
            if [ -n "${TMUX:-}" ]; then
                tmux switch-client -t "$session" # tmux refuses to nest sessions
            else
                tmux attach-session -t "$session"
            fi
            return
        fi
        (cd "$root" && scripts/serve)
        return
    fi

    # scripts/serve prints the branch, worktree and URL itself, so only add what it cannot know.
    (cd "$root" && scripts/serve --no-attach)
    echo "Left running in the background; attach with" \
        "\"yarn worktree serve $(relpath "$CALLER_DIR" "$root") --attach\"."
}

LIST_FORMAT='%-26s %-22s %-9s %-9s %s\n'

list_row() {
    local primary="$1" path="$2" branch="$3" containers="$4" server vite running=''
    server="$(env_value "$path/.env" SERVER_PORT)"
    vite="$(env_value "$path/.env" VITE_DEV_PORT)"

    if tmux has-session -t "$(session_target "$path")" 2> /dev/null; then
        running=dev
    fi
    # The /dist suffix keeps this from matching a worktree whose path merely starts the same.
    case $containers in
        *"$path/dist"*) running="${running:+$running, }container" ;;
    esac

    printf "$LIST_FORMAT" "$(relpath "$primary" "$path")" "$branch" "${server:-?}" "${vite:-?}" \
        "${running:--}"
}

do_list() {
    local primary line path='' branch='' containers=''
    primary="$(primary_root)"

    # Asked once for the whole listing rather than per worktree, since it is the slowest thing
    # here. Absent or unreachable, docker simply reports nothing rather than failing the command.
    if command -v docker > /dev/null; then
        containers="$(docker ps --format '{{.Label "com.docker.compose.project.working_dir"}}' \
            2> /dev/null || true)"
    fi

    printf "$LIST_FORMAT" WORKTREE BRANCH BACKEND FRONTEND SERVERS
    while IFS= read -r line; do
        case $line in
            'worktree '*) path="${line#worktree }" ;;
            'branch '*) branch="${line#branch refs/heads/}" ;;
            detached) branch='(detached)' ;;
            '')
                [ -z "$path" ] || list_row "$primary" "$path" "$branch" "$containers"
                path=''
                branch=''
                ;;
        esac
    # The porcelain output already ends with a blank line, which is what flushes the last record.
    done < <(git worktree list --porcelain)
}

# A word for pasting into bash or zsh. Branch names may hold characters either would expand, and
# zsh expands even a leading "=", which printf %q leaves alone, so anything unusual is single-quoted.
shell_quote() {
    case $1 in
        # sed, not ${1//...}, which bash 3.2 quotes differently. Git forbids newlines in names.
        *[!A-Za-z0-9._/-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
        *) printf '%s' "$1" ;;
    esac
}

# The name a worktree's backups are filed under: its directory under .worktrees/ flattened into
# one level, or "_main" for the main checkout, which slugify cannot produce.
worktree_name() {
    local primary
    primary="$(primary_root)"
    case $1 in
        "$primary") printf '_main\n' ;;
        "$primary/.worktrees/"*) slugify "${1#"$primary/.worktrees/"}" ;;
        *) slugify "$(basename "$1")" ;;
    esac
}

# The worktree whose backups the user named. A bare name is taken as it is, since the worktree
# may already have gone; a path is looked up.
backup_owner() {
    local root dir primary name
    case $1 in
        '') die "Name a worktree. Try \"yarn worktree help $COMMAND\"." ;;
        /* | .* | */*)
            # This runs inside $(...), where set -e does not apply
            root="$(target_root "$1")" || exit
            dir="$(cd "$(resolve_dir "$1")" && pwd -P)"
            primary="$(primary_root)"
            # A leftover directory under .worktrees/ would otherwise count as the main checkout
            case $dir/ in
                "$primary/.worktrees/"*) [ "$root" != "$primary" ] || die "$1 is not a worktree." ;;
            esac
            git worktree list --porcelain | grep -qxF "worktree $root" \
                || die "$1 is not a worktree of this repository."
            name="$(worktree_name "$root")"
            ;;
        _main) name=_main ;;
        *) name="$(slugify "$1")" ;;
    esac
    [ -n "$name" ] && git check-ref-format "refs/backup/$name/x" \
        || die "Not a worktree name: \"$1\""
    printf '%s\n' "$name"
}

# stamp_epoch gives the seconds since the epoch for a stamp such as 2026-10-25T1115Z, and
# format_epoch formats those seconds in local time unless TZ says otherwise. Only GNU date takes
# --version; BSD's, as on macOS, takes other options for both.
if date --version > /dev/null 2>&1; then
    stamp_epoch() {
        date -u -d "${1:0:10} ${1:11:2}:${1:13:2}" +%s 2> /dev/null
    }
    format_epoch() {
        date -d "@$1" "$2"
    }
else
    stamp_epoch() {
        # Given no seconds, BSD date would take them from the current time
        date -u -j -f '%Y-%m-%dT%H%MZ%S' "${1}00" +%s 2> /dev/null
    }
    format_epoch() {
        date -r "$1" "$2"
    }
fi

# A stamp as it is listed: in local time, with its offset if that hour happens twice when the
# clocks go back, or with --utc in UTC. Left as it is if date cannot read it.
show_time() {
    local epoch wall shift offset
    epoch="$(stamp_epoch "$1")" || {
        printf '%s\n' "$1"
        return
    }
    if [ "$UTC" -eq 1 ]; then
        TZ=UTC0 format_epoch "$epoch" '+%Y-%m-%d %H:%MZ'
        return
    fi
    wall="$(format_epoch "$epoch" '+%Y-%m-%d %H:%M')"
    # Clocks go back by an hour, or in a few places by half an hour
    for shift in -3600 -1800 1800 3600; do
        if [ "$(format_epoch $((epoch + shift)) '+%Y-%m-%d %H:%M')" = "$wall" ]; then
            offset="$(format_epoch "$epoch" +%z)"
            printf '%s%s:%s\n' "$wall" "${offset:0:3}" "${offset:3:2}"
            return
        fi
    done
    printf '%s\n' "$wall"
}

# A time given after a label's @: a full time, a time of day or a date, then optionally Z or an
# offset. A full time may leave out its colon, as in a ref's name, or have a space for the T, as
# in a listing.
TIME_RE='^(([0-9]{4}-[0-9]{2}-[0-9]{2})([T ]([0-9]{2}):?([0-9]{2}))?|([0-9]{2}):([0-9]{2}))'
TIME_RE="$TIME_RE"'(Z|([+-])([0-9]{2})(:?([0-9]{2}))?)?$'

# Whether a stamp is at a time matching TIME_RE, which is local unless it ends in Z or an offset,
# or --utc is given.
time_matches() {
    local epoch wall want sign secs
    [[ $2 =~ $TIME_RE ]] || die "Not a time: \"$2\""
    want="${BASH_REMATCH[2]}"
    if [ -n "${BASH_REMATCH[4]}" ]; then
        want="$want ${BASH_REMATCH[4]}:${BASH_REMATCH[5]}"
    elif [ -n "${BASH_REMATCH[6]}" ]; then
        want="${BASH_REMATCH[6]}:${BASH_REMATCH[7]}"
    fi

    epoch="$(stamp_epoch "$1")" || die "date cannot read the time $1."
    if [ -n "${BASH_REMATCH[9]}" ]; then
        # An offset: render in UTC the moment shifted by it
        sign="${BASH_REMATCH[9]}"
        secs=$((10#${BASH_REMATCH[10]} * 3600 + 10#${BASH_REMATCH[12]:-0} * 60))
        wall="$(TZ=UTC0 format_epoch $((epoch $sign secs)) '+%Y-%m-%d %H:%M')"
    elif [ -n "${BASH_REMATCH[8]}" ] || [ "$UTC" -eq 1 ]; then
        wall="$(TZ=UTC0 format_epoch "$epoch" '+%Y-%m-%d %H:%M')"
    else
        wall="$(format_epoch "$epoch" '+%Y-%m-%d %H:%M')"
    fi

    case $want in
        *-*' '*) [ "$wall" = "$want" ] ;;
        *-*) [ "${wall%% *}" = "$want" ] ;;
        *) [ "${wall#* }" = "$want" ] ;;
    esac
}

# One line per backup ref given: its time, commit and label. $1 is 1 to head each worktree's
# backups with its name.
list_backups() {
    local grouped="$1" ref rest time i last=''
    local owners=() times=() commits=() labels=() tw=0
    shift
    for ref in "$@"; do
        rest="${ref#refs/backup/}"
        owners=("${owners[@]}" "${rest%/*}")
        rest="${rest##*/}"
        time="$(show_time "${rest:0:16}")"
        times=("${times[@]}" "$time")
        commits=("${commits[@]}" "$(git rev-parse --short "$ref")")
        labels=("${labels[@]}" "${rest:17}")
        [ "${#time}" -le "$tw" ] || tw="${#time}"
    done

    for ((i = 0; i < ${#labels[@]}; i++)); do
        if [ "$grouped" -eq 1 ] && [ "${owners[i]}" != "$last" ]; then
            printf '%s\n' "${owners[i]}"
            last="${owners[i]}"
        fi
        printf '  %-*s  %s  %s\n' "$tw" "${times[i]}" "${commits[i]}" "${labels[i]}"
    done
}

# A worktree's backup refs, newest first: only those one level down, as backup makes them.
backup_refs() {
    git for-each-ref --sort=-refname --format='%(refname)' "refs/backup/$1/" \
        | grep -v "^refs/backup/$1/.*/" || true
}

# Another worktree whose backups are filed under name $2, like those of worktree $1.
shared_with() {
    local line path=''
    git worktree list --porcelain | while IFS= read -r line; do
        case $line in
            'worktree '*) path="${line#worktree }" ;;
            # Deleted without git worktree remove, and only waiting to be pruned
            prunable*) path='' ;;
            '')
                if [ -n "$path" ] && [ "$path" != "$1" ] \
                    && [ "$(worktree_name "$path")" = "$2" ]; then
                    printf '%s\n' "$path"
                    break
                fi
                path=''
                ;;
        esac
    done
}

do_backup() {
    local label="$1" root name other commit ref old
    [ -n "$label" ] || {
        usage backup >&2
        exit 1
    }
    case $label in
        */* | *@*) die "A label cannot contain a slash or an @: \"$label\"" ;;
        -*) die "A label cannot start with a -: \"$label\"" ;;
    esac
    root="$(worktree_root "$CALLER_DIR")"
    name="$(worktree_name "$root")"
    [ -n "$name" ] || die "Cannot name backups after $(relpath "$(primary_root)" "$root")," \
        "as its name has no letters or digits."$'\n'"Stop its dev servers, then rename it from" \
        "the main checkout with \"git worktree move $(relpath "$(primary_root)" "$root") <new path>\"."
    other="$(shared_with "$root" "$name")"
    [ -z "$other" ] || die "$(relpath "$(primary_root)" "$root") and $(relpath "$(primary_root)" "$other")" \
        "would both file their backups as $name."$'\n'"Move or rename one of them first."
    commit="$(git -C "$root" rev-parse --verify --quiet "${2:-HEAD}^{commit}")" \
        || die "Not a commit: \"${2:-HEAD}\""
    ref="refs/backup/$name/$(date -u '+%Y-%m-%dT%H%MZ')-$label"
    git check-ref-format "$ref" || die "Not a valid label: \"$label\""

    if old="$(git rev-parse --verify --quiet "$ref")"; then
        [ "$FORCE" -gt 0 ] \
            || die "$ref already exists, at $(git rev-parse --short "$old")."$'\n'"Pass -f to replace it."
        git update-ref "$ref" "$commit" "$old"
        printf 'Replaced %s (was %s) with %s.\n' "$ref" "$(git rev-parse --short "$old")" \
            "$(git rev-parse --short "$commit")"
    else
        git update-ref "$ref" "$commit" ''
        printf 'Backed up %s as %s.\n' "$(git rev-parse --short "$commit")" "$ref"
    fi
    printf 'Delete it once nothing needs it: git update-ref -d %s\n' "$(shell_quote "$ref")"
}

# Delete the backups of worktree $1 with the labels that follow, each optionally @<time>, or all
# of them if none follow. Checks every argument before deleting anything.
delete_backups() {
    local name refs ref arg label time rest matches selected=()
    name="$(backup_owner "$1")"
    shift
    refs="$(backup_refs "$name")"
    [ -n "$refs" ] || die "$name has no backups."

    if [ $# -eq 0 ]; then
        selected=($refs)
    fi
    for arg in "$@"; do
        label="${arg%%@*}"
        time=''
        case $arg in
            *@*)
                time="${arg#*@}"
                [[ $time =~ $TIME_RE ]] || die "Not a time: \"$time\""
                ;;
        esac
        matches=()
        for ref in $refs; do
            rest="${ref##*/}"
            if [ "${rest:17}" = "$label" ] && { [ -z "$time" ] || time_matches "${rest:0:16}" "$time"; }; then
                matches=("${matches[@]}" "$ref")
            fi
        done
        if [ ${#matches[@]} -eq 0 ]; then
            for ref in $refs; do
                rest="${ref##*/}"
                [ "${rest:17}" != "$label" ] || matches=("${matches[@]}" "$ref")
            done
            if [ ${#matches[@]} -eq 0 ]; then
                printf '%s has no backup labelled %s. Its backups are:\n' "$name" "$label" >&2
                list_backups 0 $refs >&2
            else
                printf 'No %s backup is at %s. Those with that label are:\n' "$label" "$time" >&2
                list_backups 0 "${matches[@]}" >&2
            fi
            die 'Nothing was deleted.'
        elif [ -n "$time" ] && [ ${#matches[@]} -gt 1 ]; then
            printf '%s matches more than one backup:\n' "$arg" >&2
            list_backups 0 "${matches[@]}" >&2
            die 'Nothing was deleted. Give a full time, with an offset or Z if it repeats.'
        fi
        selected=("${selected[@]}" "${matches[@]}")
    done

    delete_refs "${selected[@]}"
}

# Delete backup refs all at once or not at all, saying which commit each was at.
delete_refs() {
    local ref seen=' ' changes='' report=''
    for ref in "$@"; do
        # The same backup may be named twice
        case $seen in
            *" $ref "*) continue ;;
        esac
        seen="$seen$ref "
        changes="${changes}delete $ref $(git rev-parse "$ref")"$'\n'
        report="${report}Deleted $ref (was $(git rev-parse --short "$ref"))"$'\n'
    done
    printf '%s' "$changes" | git update-ref --stdin || die 'Nothing was deleted.'
    printf '%s' "$report"
}

do_backups() {
    local name refs
    if [ "$DELETE" -eq 1 ]; then
        delete_backups "${ARGS[@]}"
        return
    fi
    [ ${#ARGS[@]} -le 1 ] || die "Name at most one worktree. Try \"yarn worktree help backups\"."

    if [ -n "${ARGS[0]}" ]; then
        name="$(backup_owner "${ARGS[0]}")"
        refs="$(backup_refs "$name")"
        if [ -z "$refs" ]; then
            echo "$name has no backups."
            return
        fi
        list_backups 0 $refs
        printf '\nDelete one with "yarn worktree backups --delete %s <label>[@<time>]", or all of them by leaving out the label.\n' \
            "$(shell_quote "$name")"
    else
        refs="$(git for-each-ref --sort=-refname --format='%(refname)' refs/backup/ \
            | grep -v '^refs/backup/[^/]*/.*/' | sort -t/ -k3,3 -s || true)"
        if [ -z "$refs" ]; then
            echo 'No backups.'
            return
        fi
        list_backups 1 $refs
        printf '\nDelete some with "yarn worktree backups --delete <worktree> <label>[@<time>]", or all of a worktree'"'"'s by leaving out the label.\n'
    fi
}

do_remove() {
    local root session dirty branch head name shared refs count them
    root="$(target_root "$1")"
    [ "$root" != "$(primary_root)" ] || die "Refusing to remove the main checkout."
    name="$(worktree_name "$root")"
    shared="$(shared_with "$root" "$name")"
    # Read now, as the worktree it comes from is about to go
    branch="$(git -C "$root" branch --show-current 2> /dev/null || true)"
    head="$(git -C "$root" rev-parse --short HEAD 2> /dev/null || true)"

    if [ "$FORCE" -eq 0 ]; then
        dirty="$(git -C "$root" status --porcelain)"
        if [ -n "$dirty" ]; then
            printf 'Work that would be lost in %s:\n%s\n' \
                "$(relpath "$CALLER_DIR" "$root")" "$dirty" >&2
            die 'Deal with it, or pass --force to delete the worktree anyway.'
        fi
    fi

    session="$(session_target "$root")"
    if tmux has-session -t "$session" 2> /dev/null; then
        tmux kill-session -t "$session"
        echo "Stopped the dev servers."
    fi

    # Containers outlive the worktree they were started from, and compose cannot stop them once
    # its file is gone, so take them down first. Found by the directory compose recorded, which
    # covers every environment this worktree started.
    if command -v docker > /dev/null; then
        for project in $(docker ps -a --format '{{.Label "com.docker.compose.project"}}' \
            --filter "label=com.docker.compose.project.working_dir=$root/dist" | sort -u); do
            docker compose -p "$project" down > /dev/null 2>&1 || true
            echo "Stopped the $project container."
        done
    fi

    # Always --force, so that the check above is the only thing deciding whether removing this
    # worktree is safe. Git tolerates the ignored files that setting one up leaves behind (.env
    # and node_modules), but it should not get a second opinion on files we put there
    # deliberately.
    if [ "$FORCE" -ge 2 ]; then
        git worktree remove --force --force "$root" # twice, to unlock a locked worktree
    else
        git worktree remove --force "$root"
    fi
    git worktree prune
    echo "Removed $(relpath "$CALLER_DIR" "$root")."
    # Only a branch that still exists can be deleted: an orphan branch has no commits yet
    if [ -n "$branch" ] && git show-ref --verify --quiet "refs/heads/$branch"; then
        printf 'Its branch %s is untouched; "git branch -d %s" if you are done with it.\n' \
            "$branch" "$(shell_quote "$branch")"
    else
        # Mid-rebase or mid-bisect a branch may still exist, just not as the checked-out one. The
        # commit is printed as nothing else may point to it once the worktree has gone.
        if [ -n "$head" ]; then
            echo "It was not on a branch, and was at commit $head."
        else
            echo 'It was not on a branch.'
        fi
    fi

    refs="$(backup_refs "$name")"
    if [ -n "$refs" ] && [ -n "$shared" ]; then
        printf 'Its backups are filed as %s, together with those of %s, so are left alone.\n' \
            "$name" "$(relpath "$(primary_root)" "$shared")"
        printf 'See them with "yarn worktree backups %s".\n' "$(shell_quote "$name")"
    elif [ -n "$refs" ] && [ "$DELETE_BACKUPS" -eq 1 ]; then
        delete_refs $refs
    elif [ -n "$refs" ]; then
        count="$(printf '%s\n' "$refs" | wc -l | tr -d ' ')"
        if [ "$count" -eq 1 ]; then
            echo 'It still has 1 backup, which keeps its commit alive until it is deleted:'
            them=it
        else
            echo "It still has $count backups, which keep their commits alive until they are deleted:"
            them=them
        fi
        list_backups 0 $refs
        printf 'Delete %s with "yarn worktree backups --delete %s" once nothing needs %s.\n' \
            "$them" "$(shell_quote "$name")" "$them"
    fi
}

do_add() {
    local start="$1" dir primary branch opts

    primary="$(primary_root)"

    # Check the ports before creating anything, so that a port clash does not leave a half
    # set-up worktree behind.
    if [ -n "$PORT" ]; then
        require_free_ports "$PORT"
    fi

    # Decide what will be checked out, following "git worktree add": -b/-B name a branch to
    # create at <commit-ish>; an existing commit-ish is checked out as it stands, which git
    # attaches for a branch and detaches for a tag or commit; and a name that resolves to
    # nothing is taken as a new branch off HEAD.
    if [ -n "$NEW_BRANCH" ]; then
        branch="$NEW_BRANCH"
        start="${start:-HEAD}"
    elif [ -z "$start" ]; then
        usage add >&2
        exit 1
    elif [ "$DETACH" -eq 1 ]; then
        # Asking to detach says <commit-ish> is meant to exist, so let git reject it if it does
        # not, rather than quietly treating it as a new branch name and detaching at HEAD.
        branch=''
    elif git rev-parse --verify --quiet "$start^{commit}" > /dev/null; then
        branch=''
    else
        branch="$start"
        start=HEAD
    fi

    if [ -n "$2" ]; then
        dir="$(resolve_dir "$2")"
    else
        # Kept inside the checkout so that the EXTENDS and SESSIONS_DIR paths written into the
        # worktree's .env do not depend on what the main checkout's directory is called.
        dir="$primary/.worktrees/$(slugify "${branch:-$start}")"
    fi
    [ -e "$dir" ] && die "$dir already exists."

    # Assembled rather than branched on, so that git applies its own rules to its own options:
    # -b, -B and --detach are mutually exclusive, and it says so better than we would.
    opts=()
    if [ -n "$branch" ]; then
        if [ "$RESET_BRANCH" -eq 1 ]; then
            opts=(-B "$branch")
        else
            opts=(-b "$branch")
        fi
    fi
    if [ "$DETACH" -eq 1 ]; then
        opts=("${opts[@]}" --detach)
    fi
    git worktree add "${opts[@]}" "$dir" "$start"

    do_bootstrap "$dir"
    if [ "$SERVE" -eq 1 ]; then
        do_serve "$dir"
    else
        echo "Start it with \"yarn worktree serve $(relpath "$CALLER_DIR" "$dir")\"."
    fi
}

COMMAND="${1:-help}"
[ $# -gt 0 ] && shift

case $COMMAND in
    add | a)
        COMMAND=add
        parse_args "port install serve attach branch detach" "$@"
        # Ours to check rather than git's: either polarity is meaningless unless we will serve.
        if [ -n "$ATTACH" ] && [ "$SERVE" -eq 0 ]; then
            die "--attach and --no-attach need --serve."
        fi
        do_add "${ARGS[0]}" "${ARGS[1]}"
        ;;
    bootstrap | b)
        COMMAND=bootstrap
        parse_args "port install force" "$@"
        do_bootstrap "${ARGS[0]}"
        ;;
    serve | s)
        COMMAND=serve
        parse_args "attach" "$@"
        do_serve "${ARGS[0]}"
        ;;
    list | l | ls)
        COMMAND=list
        parse_args "" "$@"
        do_list
        ;;
    remove | r | rm)
        COMMAND=remove
        parse_args "force delete-backups utc" "$@"
        do_remove "${ARGS[0]}"
        ;;
    backup)
        parse_args "force utc" "$@"
        do_backup "${ARGS[0]}" "${ARGS[1]}"
        ;;
    backups)
        parse_args "delete utc" "$@"
        do_backups
        ;;
    help | h | -h | --help)
        usage "${1:-}"
        ;;
    *)
        printf 'Unknown command "%s".\n\n' "$COMMAND" >&2
        usage >&2
        exit 1
        ;;
esac
