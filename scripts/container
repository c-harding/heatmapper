#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

. scripts/lib
. scripts/get-env "$@"

if [ -z "$DOTENV_FILE" ]; then
  echo 'No env file to run with; create dist/.env by copying dist/sample.env.' >&2
  exit 1
fi

SERVER_PORT="$(env_value .env SERVER_PORT)" \
  docker compose -f dist/docker-compose.yml --env-file "$DOTENV_FILE" \
  --project-name "$(compose_project "$ENV")" up "${REST_ARGS[@]}"
