#!/usr/bin/env bash

# Exit on first error
set -e

cd "$(dirname "$0")/.."

. scripts/connect "$@"

if [ -z "$DOTENV_FILE" ]; then
  echo 'No env file was found, so there is nothing to deploy with.' >&2
  echo 'Create dist/.env by copying dist/sample.env, or name one with -e / --env.' >&2
  echo >&2
  exit 1
fi

# On the server, start the docker process, clear old docker images and then set up port forwarding
# (assuming the server is set up as in this gist:
# https://gist.github.com/c-harding/59686990f42f4dddae01dffa56618ea4, if not then this stage is
# simply skipped).
(
  RAW_DOMAIN="${SERVER_DOMAIN/#*\/\//}"
  DEPLOY_COMMAND="$(printf '
    (cd %q && rm -f ?*.env) &&
    docker compose -f%q/docker-compose.yml up --build -d &&
    docker system prune -f &&
    (command -v add-site > /dev/null && add-site %q %d; true)
  ' "${DEPLOY_DIR:-.}" "${DEPLOY_DIR:-.}" "$RAW_DOMAIN" "$SERVER_PORT")"

  rsync -re"ssh $DEPLOY_FLAG" --exclude='*.env' --exclude-from=dist/.rsyncignore \
    dist/ "$DEPLOY_TARGET":"${DEPLOY_DIR:-.}"

  # Send the env file separately, so the correct file for the branch and worktree is used
  rsync -e"ssh $DEPLOY_FLAG" "$DOTENV_FILE" "$DEPLOY_TARGET":"${DEPLOY_DIR:-.}/.env"

  ssh $DEPLOY_FLAG "$DEPLOY_TARGET" "$DEPLOY_COMMAND"
)

# The container starts detached, and pm2 restarts a crashing app inside it, so neither shows whether
# the app came up: ask the site itself
if [ -n "$SERVER_DOMAIN" ]; then
  deadline=$((SECONDS + 30))
  until status="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$SERVER_DOMAIN/")" && [ "$status" = 200 ]; do
    if ((SECONDS >= deadline)); then
      printf '%s still answered %s 30 seconds after deploying.\n' "$SERVER_DOMAIN" "$status" >&2
      exit 1
    fi
    sleep 1
  done
  echo "$SERVER_DOMAIN is up."
fi

# Deploying doesn't move Strava's subscription, so say if it points elsewhere. Only the receiver's
# env file names its token, so only that one can tell.
if [ -n "$WEBHOOK_RECEIVER" ] && [ "${WEBHOOK_RECEIVER%/}" = "${SERVER_DOMAIN%/}" ]; then
  scripts/webhook-subscription -e "$ENV" --quiet || true
fi
