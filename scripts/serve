#!/usr/bin/env bash

set -e

close_all() {
    close_one='tmux send-keys -t "$1" C-c'
    tmux lsp -F "#D" | grep -v "$TMUX_PANE" | xargs -L1 bash -c $close_one close_one
}
escape() {
    printf "%q " "$@"
}
wrapper() {
    trap "trap - INT; close_all" INT
    $@
    exit_code=$?
    trap - INT

    # If wasn’t sigint or sighup, stay open
    [ $exit_code -ne 130 ] && [ $exit_code -ne 129 ] && (
        if [ $exit_code -eq 0 ]
        then echo "[Process completed successfully, press enter to close]"
        else echo "[Process exited with code $exit_code, press enter to quit]"
        fi
        read
        close_all
    )
}
wrap() {
    declare -f close_all
    declare -f escape
    declare -f wrapper
    escape wrapper "$@"
}

cd "$(dirname "$0")/.."

. scripts/lib

DETACH_FLAG=''

while (($#)); do
    case $1 in
        -d | --detach)
            DETACH_FLAG='-d'
            shift
            ;;
        -h | --help)
            cat <<'EOF'
Usage: yarn serve [--detach]

Run the frontend and backend dev servers side by side in a tmux session. Ctrl-C in either pane
stops both. Detach from the session with ^b d, and come back to it with "tmux attach".

Options:
  -d, --detach  leave the servers running in the background instead of attaching to them
EOF
            exit 0
            ;;
        *)
            echo "Unknown option $1" >&2
            exit 1
            ;;
    esac
done

# Checked after the arguments, so that --help works whether or not tmux is installed.
if ! command -v tmux &> /dev/null
then
    echo "Please install tmux to continue" >&2
    exit 1
fi

# Say which checkout these servers belong to: with several worktrees running at once, the ports
# are the only thing telling them apart in the browser.
VITE_DEV_PORT="$(env_value .env VITE_DEV_PORT)"

printf 'Serving %s' "$(branch_label)"
if is_linked_worktree; then
    printf ' (worktree %s)' "$(relpath "$(primary_root)" "$PWD")"
fi
printf ' at http://localhost:%s/\n' "${VITE_DEV_PORT:-8081}"

SESSION_NAME="$(session_name)"
SESSION_TARGET="$(session_target)"
(
    tmux kill-session -t "$SESSION_TARGET" 2>/dev/null || true

    tmux new-session $DETACH_FLAG -s "$SESSION_NAME" -c "$PWD/client" "$(wrap yarn serve)" \;\
         split-window -v                             -c "$PWD/server" "$(wrap yarn serve)"
)
