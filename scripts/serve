#!/usr/bin/env bash

set -e

close_all() {
    close_one='tmux send-keys -t "$1" C-c'
    tmux lsp -F "#D" | grep -v "$TMUX_PANE" | xargs -L1 bash -c $close_one close_one
}
escape() {
    printf "%q " "$@"
}
wrapper() {
    trap "trap - INT; close_all" INT
    $@
    exit_code=$?
    trap - INT

    # If wasn’t sigint or sighup, stay open
    [ $exit_code -ne 130 ] && [ $exit_code -ne 129 ] && (
        if [ $exit_code -eq 0 ]
        then echo "[Process completed successfully, press enter to close]"
        else echo "[Process exited with code $exit_code, press enter to quit]"
        fi
        read
        close_all
    )
}
wrap() {
    declare -f close_all
    declare -f escape
    declare -f wrapper
    escape wrapper "$@"
}

cd "$(dirname "$0")/.."

. scripts/lib

DETACH_FLAG=''

while (($#)); do
    case $1 in
        -A | --no-attach)
            # tmux calls this detaching, hence its -d; here it just means "do not attach me".
            DETACH_FLAG='-d'
            shift
            ;;
        -h | --help)
            cat <<'EOF'
Usage: yarn serve [-A]

Run the frontend and backend dev servers side by side in a tmux session. Ctrl-C in either pane
stops both. Detach from the session with ^b d, and come back to it with "tmux attach".

Options:
  -A, --no-attach  leave the servers running in the background instead of attaching to them
EOF
            exit 0
            ;;
        *)
            echo "Unknown option $1" >&2
            exit 1
            ;;
    esac
done

# Checked after the arguments, so that --help works whether or not tmux is installed.
if ! command -v tmux &> /dev/null
then
    echo "Please install tmux to continue" >&2
    exit 1
fi

# tmux will not create a session from inside one, so create it detached and move the client
# there instead: the same end state, reached the only way tmux allows.
SWITCH=0
if [ -z "$DETACH_FLAG" ] && [ -n "${TMUX:-}" ]; then
    DETACH_FLAG='-d'
    SWITCH=1
fi

# Without its own .env a worktree falls back to the defaults, which are the main checkout's
# ports, so the backend would fail on a port already in use rather than say what is wrong. The
# main checkout is left alone: running there without a .env is the state setup starts from.
if is_linked_worktree && [ ! -f .env ]; then
    echo 'This worktree has no .env; run "yarn worktree bootstrap" here first.' >&2
    exit 1
fi

# -x rather than -e, so that a shim left dangling by an install from a branch using a different
# layout counts as broken too. Otherwise both panes just say "command not found".
if [ ! -x client/node_modules/.bin/vite ] || [ ! -x server/node_modules/.bin/nodemon ]; then
    echo 'Dependencies are missing or broken; run "yarn" here first.' >&2
    exit 1
fi

VITE_DEV_PORT="$(env_value .env VITE_DEV_PORT)"

printf 'Serving %s' "$(branch_label)"
if is_linked_worktree; then
    printf ' (worktree %s)' "$(relpath "$(primary_root)" "$PWD")"
fi
printf ' at http://localhost:%s/\n' "${VITE_DEV_PORT:-8081}"

SESSION_NAME="$(session_name)"
SESSION_TARGET="$(session_target)"
(
    tmux kill-session -t "$SESSION_TARGET" 2>/dev/null || true

    # split-window needs to name the session: with -d there is no current session, so an
    # untargeted split lands in whichever session invoked this one. It takes a target-pane, where
    # the "=" of session_target is not accepted; the bare name is still safe, because tmux
    # resolves an exact session name before trying it as a prefix.
    tmux new-session $DETACH_FLAG -s "$SESSION_NAME" -c "$PWD/client" "$(wrap yarn serve)" \;\
         split-window -v -t "$SESSION_NAME"          -c "$PWD/server" "$(wrap yarn serve)"
)

if [ "$SWITCH" -eq 1 ]; then
    # Put the client back where it came from once these servers stop. The default,
    # detach-on-destroy on, would drop it out of tmux altogether instead. Set only on the session
    # we made, and only when we moved the client, so nothing else changes behaviour.
    tmux set-option -t "$SESSION_NAME" detach-on-destroy previous
    tmux switch-client -t "$SESSION_TARGET"
fi
